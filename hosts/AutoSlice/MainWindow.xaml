<Window x:Class="AutoSlice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoSlice 下载器" Height="560" Width="860"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel Margin="10">

        <!-- 顶部：URL 输入 -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="下载地址:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="UrlBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                     AcceptsReturn="False" ToolTip="支持多源镜像，用空格或 | 分隔多个 URL；下载地址一栏回车即开始"/>
        </Grid>

        <!-- 中间：线程 / 保存目录 / 文件名 -->
        <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="线程:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="ThreadsBox" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0"/>
            <Label Content="保存到:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="DirBox" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseDirBtn" Grid.Column="4" Content="浏览…" Width="70" Height="26" Margin="6,0,0,0"
                    Click="BrowseDir_Click"/>
            <Button x:Name="OpenDirBtn" Grid.Column="5" Content="打开" Width="60" Height="26" Margin="6,0,0,0"
                    Click="OpenSaveDir_Click" ToolTip="打开当前保存目录"/>
        </Grid>

        <!-- 文件名（自动从 URL 推断，可手动改） -->
        <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="文件名:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                     ToolTip="留空则自动取自第一个 URL 的文件名"/>
        </Grid>

        <!-- 操作行：下载 / 取消 + 进度 -->
        <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Content="开始下载" Width="110" Height="30" FontWeight="Bold"
                    Click="Start_Click" IsDefault="True"/>
            <Button x:Name="CancelBtn" Grid.Column="1" Content="取消" Width="70" Height="30" Margin="8,0,0,0"
                    IsEnabled="False" Click="Cancel_Click"/>
            <ProgressBar x:Name="Progress" Grid.Column="2" Height="22" Margin="12,0,10,0"
                         VerticalAlignment="Center" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center" Foreground="#333"
                       ToolTip="状态文本"/>
        </Grid>

        <TextBlock x:Name="SpeedText" DockPanel.Dock="Top" Margin="0,4,0,0" Foreground="#777"/>

        <!-- 历史记录 -->
        <TextBlock DockPanel.Dock="Bottom" Text="历史记录" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <Grid DockPanel.Dock="Bottom" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenHistoryBtn" Grid.Column="1" Content="打开所在文件夹" Width="120" Height="26"
                    Click="OpenHistoryFolder_Click"/>
        </Grid>
        <ListView x:Name="HistoryList" DockPanel.Dock="Bottom"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="130" DisplayMemberBinding="{Binding TimeText}"/>
                    <GridViewColumn Header="文件名" Width="220" DisplayMemberBinding="{Binding Filename}"/>
                    <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="结果" Width="60" DisplayMemberBinding="{Binding ResultText}"/>
                    <GridViewColumn Header="耗时" Width="80" DisplayMemberBinding="{Binding SecondsText}"/>
                    <GridViewColumn Header="地址" Width="300" DisplayMemberBinding="{Binding Url}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>